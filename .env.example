# ==============================================================================
# DermaTrace Environment Configuration (.env.example)
# Copy this file to .env and configure your production values.
# ==============================================================================

# 1. JWT Authentication Secret Key (32+ random characters)
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
DT_SECRET=change_this_to_a_random_32_character_secret_string

# 2. Database Connection URL (Optional - defaults to SQLite if left empty)
# PostgreSQL connection string for Render, Neon, Supabase, Railway, AWS RDS, etc.
# Format: postgresql://username:password@hostname:5432/database_name
# DATABASE_URL=postgresql://postgres:password@ep-sample-1234.us-east-2.aws.neon.tech/dermatrace?sslmode=require

# 3. Server Network Binding
HOST=0.0.0.0
PORT=8000
