<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Friendly 3D App Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="✨ DermaTrace"
            android:textColor="@color/clay_text_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Skin Monitoring • Friendly, Tactile &amp; Accurate"
            android:textColor="@color/clay_text_body"
            android:textSize="14sp" />

        <!-- Main Claymorphic Auth Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clay_card"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Role Selector Tabs (Clay style) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_clay_input"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabClientRole"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_clay_pill_button"
                        android:gravity="center"
                        android:text="👤 Client / Patient"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabAdminRole"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🩺 Admin / Clinician"
                        android:textColor="@color/clay_text_body"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Auth Mode Switcher (Sign In vs Register) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAuthTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sign In to Your Account"
                        android:textColor="@color/clay_text_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnToggleAuthMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New? Register"
                        android:textColor="@color/clay_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Name field (shown on registration) -->
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_clay_input"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/clay_text_title"
                    android:textColorHint="@color/clay_text_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Email Input -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_clay_input"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/clay_text_title"
                    android:textColorHint="@color/clay_text_muted"
                    android:textSize="14sp" />

                <!-- Password Input -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_clay_input"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/clay_text_title"
                    android:textColorHint="@color/clay_text_muted"
                    android:textSize="14sp" />

                <!-- Primary Squishy Claymorphic Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitAuth"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="@color/clay_primary"
                    android:text="Continue to App ➔"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <!-- 1-Click Quick Demo Login Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ 1-Tap Quick Credentials"
                        android:textColor="@color/clay_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickPatient"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="👤 Client Demo"
                            android:textSize="11sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="@color/clay_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickAdmin"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="🩺 Admin Demo"
                            android:textColor="@color/clay_coral"
                            android:textSize="11sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="@color/clay_coral" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Connectivity pill -->
        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_clay_safe"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="● Backend Active (http://10.0.2.2:8000)"
            android:textColor="#166534"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
