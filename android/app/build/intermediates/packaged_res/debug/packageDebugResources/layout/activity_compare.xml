<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 Lesion Comparison"
                    android:textColor="@color/clay_text_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Session 1 (Baseline) vs Session N (Current)"
                    android:textColor="@color/clay_text_body"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToDashboard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ Close"
                android:textColor="@color/clay_text_body"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Side-by-Side Clay Photo Comparison Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clay_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:orientation="horizontal">

                    <!-- Session 1 Photo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivBaseline"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_clay_input"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Session 1 (Baseline)"
                            android:textColor="@color/clay_text_body"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Session N Photo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivFollowup"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_clay_input"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Session N (Current)"
                            android:textColor="@color/clay_text_body"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Load Demo lesion pair button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectDemoImages"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🔄 Load Realistic Demo Lesion Scans"
                    android:textColor="@color/clay_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= FINAL CONCLUSIVE PREDICTION CARD ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clay_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Final Conclusive Clinical Prediction"
                    android:textColor="@color/clay_text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Big Squishy Decision Pill -->
                <TextView
                    android:id="@+id/tvDecisionBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_clay_safe"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:text="🟢 No Need to Visit Doctor (Stable)"
                    android:textColor="#166534"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Reassuring Advice Narrative -->
                <TextView
                    android:id="@+id/tvAdviceNarrative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Lesion is morphologically stable across visits. No significant asymmetric drift or pigment border alteration detected. Continue monthly self-check."
                    android:textColor="@color/clay_text_body"
                    android:textSize="13sp" />

                <!-- Confidence rating -->
                <TextView
                    android:id="@+id/tvConfidenceVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clinical Confidence: 94% • Deep Siamese MobileNetV2"
                    android:textColor="@color/clay_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= ABCDE SCORECARD ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clay_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 ABCDE Clinical Dermatological Criteria"
                    android:textColor="@color/clay_text_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Standard medical criteria evaluated on your skin photos"
                    android:textColor="@color/clay_text_body"
                    android:textSize="12sp" />

                <!-- A: Asymmetry -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="[A] Asymmetry"
                        android:textColor="@color/clay_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_safe"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Symmetric (0/2)"
                        android:textColor="#166534"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- B: Border Irregularity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="[B] Border Definition"
                        android:textColor="@color/clay_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_safe"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Smooth (0/2)"
                        android:textColor="#166534"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- C: Color Uniformity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="[C] Color Uniformity"
                        android:textColor="@color/clay_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_safe"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Uniform Tan (0/2)"
                        android:textColor="#166534"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- D: Diameter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="[D] Diameter"
                        android:textColor="@color/clay_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_clay_safe"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="4.2 mm (&lt; 6mm)"
                        android:textColor="#166534"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- E: Evolution / Change Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="[E] Evolution / Change Score"
                        android:textColor="@color/clay_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvScoreE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 / 100"
                        android:textColor="@color/clay_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbChangeScore"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="14" />

                <!-- Re-run Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunCompareApi"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/clay_primary"
                    android:text="⚡ Run Deep Learning Comparison"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="27dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
